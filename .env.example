# RepGrid Experiment Configuration
# Copy this file to .env and fill in your API keys

# Anthropic API Key (required)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI API Key (required for construct embedding)
# Get yours at: https://dash.voyageai.com/
VOYAGE_API_KEY=pa-...

# OpenAI API Key (required for GPT models)
# Get yours at: https://platform.openai.com/
OPENAI_API_KEY=sk-...

# Google API Key (required for Gemini models)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# DeepSeek API Key (required for DeepSeek models)
# Get yours at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# OpenRouter API Key (required for OpenRouter models, e.g. DeepSeek via OpenRouter)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Optional: app attribution headers for OpenRouter analytics
OPENROUTER_REFERER=
OPENROUTER_TITLE=RepGrid

# Server Configuration (optional)
PORT=3001
HOST=0.0.0.0

# Storage backend: 'fs' (local filesystem) or 's3' (S3/R2)
STORAGE_BACKEND=fs

# S3/R2 Configuration (required when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Authentication
JWT_SECRET=
ADMIN_EMAIL=       # Auto-created admin user email
ADMIN_PASSWORD=    # Auto-created admin user password
ADMIN_NAME=Admin   # Display name (optional, defaults to "Admin")
